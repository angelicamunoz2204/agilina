# ============================================================================
# Agilina — variables de entorno
# Copiar a .env con `make env` y completar. El .env NUNCA se versiona.
# Ningún valor real vive en este archivo: solo las claves esperadas.
# Encierra entre comillas simples cualquier valor con $, comillas o acentos
# graves: el Makefile lee este archivo con bash y los expandiría.
# ============================================================================

# ---------------------------------------------------------------- Entorno ---
AGILINA_ENTORNO=local          # local | nube
AGILINA_NIVEL_LOG=INFO         # DEBUG | INFO | WARNING | ERROR
AGILINA_IDIOMA_POR_DEFECTO=es  # es | en

# --------------------------------------------------------------- Postgres ---
POSTGRES_USUARIO=agilina
POSTGRES_CLAVE=
POSTGRES_BD=agilina
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
# La API la arma a partir de las anteriores; defínela solo para apuntar a otra base.
# AGILINA_URL_BD=postgresql+psycopg://usuario:clave@host:5432/agilina

# ------------------------------------------------------------------- API ----
AGILINA_API_HOST=127.0.0.1
AGILINA_API_PUERTO=8000
AGILINA_API_URL_PUBLICA=http://localhost:8000
AGILINA_ORIGENES_PERMITIDOS=http://localhost:4200

# -------------------------------------------------------------- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_CLAVE=
AGILINA_KEYCLOAK_URL=http://localhost:8080
AGILINA_KEYCLOAK_REALM=agilina
AGILINA_KEYCLOAK_CLIENTE_WEB=agilina-web
AGILINA_KEYCLOAK_CLIENTE_WORKER=agilina-worker
AGILINA_KEYCLOAK_SECRETO_WORKER=

# --------------------------------------------------------------- LiveKit ----
AGILINA_LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
AGILINA_LIVEKIT_API_KEY=
AGILINA_LIVEKIT_API_SECRET=

# ------------------------------------------------- Servicio de transcripción -
AGILINA_STT_URL=http://localhost:8001
AGILINA_STT_MODELO=small
AGILINA_STT_DISPOSITIVO=cpu      # cpu | cuda
AGILINA_STT_TIPO_COMPUTO=int8    # int8 | float16
AGILINA_STT_SIMULADO=true        # true en local sin GPU: devuelve texto de prueba

# -------------------------------------------------------------- ElevenLabs --
AGILINA_ELEVENLABS_API_KEY=
AGILINA_ELEVENLABS_VOZ_ES=
AGILINA_ELEVENLABS_VOZ_EN=

# ------------------------------------------------------------------ Gemini --
AGILINA_GEMINI_API_KEY=
AGILINA_GEMINI_MODELO=gemini-2.0-flash

# ------------------------------------------ Integraciones (desde Release 2) --
# Se guardan por equipo en base de datos; estas son solo las credenciales de la
# aplicación registrada ante cada proveedor.
AGILINA_SLACK_CLIENT_ID=
AGILINA_SLACK_CLIENT_SECRET=
AGILINA_SLACK_SIGNING_SECRET=
AGILINA_JIRA_CLIENT_ID=
AGILINA_JIRA_CLIENT_SECRET=
AGILINA_MS_CLIENT_ID=
AGILINA_MS_CLIENT_SECRET=
AGILINA_MS_TENANT_ID=
