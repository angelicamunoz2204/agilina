# LiveKit Cloud (proyecto agilina)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini (solo si USAR_LLM=1). Modelo verificado: gemini-3.5-flash-lite
GOOGLE_API_KEY=
GEMINI_MODEL=
# 1 = responde Gemini; 0 = responde con plantilla (AD-19)
USAR_LLM=

# ElevenLabs. Modelo: eleven_v4_turbo (por defecto en el agente)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=

# Whisper (speaches). En el Mac y en la instancia GPU: http://whisper:8000/v1 (red interna de Compose)
WHISPER_BASE_URL=
# Obligatoria: también la usa whisper-warmup. Ej.: Systran/faster-whisper-small
WHISPER_MODEL=
# Opcional: vocabulario para Whisper, p. ej. términos del equipo (Keycloak, endpoint, API). Vacío = sin prompt
WHISPER_PROMPT=
