# LiveKit Cloud (proyecto agilina)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini (solo si USAR_LLM=1). Modelo verificado: gemini-3.5-flash-lite
GOOGLE_API_KEY=
GEMINI_MODEL=
# 1 = responde Gemini; 0 = responde con plantilla (AD-19)
USAR_LLM=

# ElevenLabs. Modelo: eleven_v4_turbo (por defecto en el agente)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=

# Whisper (speaches). En el Mac y en la instancia GPU: http://whisper:8000/v1 (red interna de Compose)
WHISPER_BASE_URL=
# Obligatoria: también la usa whisper-warmup. Ej.: Systran/faster-whisper-small
WHISPER_MODEL=
# Opcional: vocabulario para Whisper, p. ej. términos del equipo (Keycloak, endpoint, API). Vacío = sin prompt
WHISPER_PROMPT=

# Entorno de la medición, se escribe en cada fila de metrics/<sala>.csv: cpu (Mac) o gpu (instancia)
ENTORNO=

# Turnos. manual (por defecto): el participante cierra su turno con "Terminar turno" (cliente/index.html, RPC
# terminar_turno). stt: el turno se cierra solo al llegar la transcripción.
MODO_TURNO=
# Espera máxima tras el botón para que el VAD dé por terminada la voz y Whisper devuelva los segmentos (s, por defecto 10)
ESPERA_TRANSCRIPCION_S=
# Opcional: máximo de voz por segmento del VAD en s. Vacío = valor de Silero (60 s; el audio que exceda se descarta)
VAD_MAX_BUFFERED_SPEECH_S=
