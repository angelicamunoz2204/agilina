{
  "realm": "agilina",
  "displayName": "Agilina",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "worker",
        "description": "Service account of the agent worker. Team roles (admin and member) do not live here: they are in the Agilina database, because a person can be a member in one team and an admin in another."
      }
    ]
  },
  "clients": [
    {
      "clientId": "agilina-web",
      "name": "Agilina web application",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "agilina-worker",
      "name": "Worker del agente",
      "description": "Service account the worker authenticates against the API with. Keycloak generates the secret when importing the realm and it is copied to .env: it does not live in the repository.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "agilina-api",
      "name": "Agilina API",
      "description": "Service account the API uses to create the account of a person who accepts an invitation (HU-02). It can only manage users. The secret is AGILINA_KEYCLOAK_API_SECRET of the .env, substituted on import: it does not live in the repository.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AGILINA_KEYCLOAK_API_SECRET}",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-agilina-worker",
      "enabled": true,
      "serviceAccountClientId": "agilina-worker",
      "realmRoles": ["worker"]
    },
    {
      "username": "service-account-agilina-api",
      "enabled": true,
      "serviceAccountClientId": "agilina-api",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "clientScopeMappings": {},
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
  }
}
