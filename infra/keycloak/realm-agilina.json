{
  "realm": "agilina",
  "displayName": "Agilina",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "worker",
        "description": "Cuenta de servicio del worker del agente. Los roles de equipo (administrador y miembro) no viven aquí: son de la base de datos de Agilina, porque una persona puede ser miembro en un equipo y administrador en otro."
      }
    ]
  },
  "clients": [
    {
      "clientId": "agilina-web",
      "name": "Aplicación web de Agilina",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "agilina-worker",
      "name": "Worker del agente",
      "description": "Cuenta de servicio con la que el worker se autentica contra la API. El secreto lo genera Keycloak al importar el realm y se copia al .env: no vive en el repositorio.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-agilina-worker",
      "enabled": true,
      "serviceAccountClientId": "agilina-worker",
      "realmRoles": ["worker"]
    }
  ],
  "clientScopeMappings": {},
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
  }
}
